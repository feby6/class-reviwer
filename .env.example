# Copy to .env (never commit it), then load it into your shell: set -a; source .env; set +a
# On Streamlit Cloud, put the same keys in the app's Secrets instead (TOML: KEY = "value").
GEMINI_API_KEY=your-key-here
# Strongly recommended when the app is reachable by others:
# APP_PASSWORD=choose-a-strong-password
# Optional (defaults shown):
# GEMINI_MODEL=gemini-3.8-flash
# RUNS_DIR=runs
# MAX_UPLOAD_MB=1000
# API_PORT=8000
# UI_PORT=8501
